{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022", "webworker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "outDir": "dist",
    "isolatedModules": true,
    "strict": true,
    "noEmit": false,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src"]
}
