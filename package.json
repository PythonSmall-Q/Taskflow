{
  "name": "taskflow-zero",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "build": "npm --workspaces run build",
    "dev": "wrangler dev --config wrangler.toml",
    "format": "prettier -w .",
    "test": "vitest --run",
    "typecheck": "tsc -b",
    "migrate": "wrangler d1 migrations apply taskflow-db --local --config wrangler.toml"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0",
    "wrangler": "^3.82.0"
  }
}
